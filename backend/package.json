{
  "name": "backend",
  "version": "1.0.0",
  "description": "CaseLab backend - REST API for the legal skills training platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts,md --exec ts-node --transpile-only src/index.ts",
    "seed": "node dist/seed/index.js",
    "seed:dev": "ts-node --transpile-only src/seed/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "health": "node dist/scripts/health-check.js",
    "eval:grading": "node dist/scripts/eval-grading.js",
    "eval:grading:dev": "ts-node --transpile-only src/scripts/eval-grading.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "amqplib": "^0.10.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "redis": "^4.6.10",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "mongodb-memory-server": "^10.1.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "express",
    "mongodb",
    "legaltech",
    "api"
  ],
  "author": "",
  "license": "MIT"
}
