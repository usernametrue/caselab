# Copy to .env and fill in. Read by docker-compose.yml (prod) and docker-compose.dev.yml (dev)

# Prefix for container names and the log service name
PROJECT_NAME=caselab

# ---------- Ports (host side) ----------
BACKEND_EXPOSE=127.0.0.1:8320
FRONTEND_EXPOSE=127.0.0.1:80
# Dev only
BACKEND_DEV_EXPOSE=127.0.0.1:3002
FRONTEND_DEV_EXPOSE=127.0.0.1:3001
MONGO_EXPOSE=127.0.0.1:8327

# ---------- MongoDB ----------
# Prod has no mongo container - set MONGO_URI (takes priority) or MONGO_HOST of the real server
# Dev uses the "mongo" container when both are empty
MONGO_URI=
MONGO_HOST=
MONGO_PORT=27017
MONGO_DATABASE=lexhackathon
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# ---------- Auth ----------
# Two different secrets, 32+ chars each, the backend refuses to start otherwise
JWT_SECRET=your_very_secure_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=another_very_secure_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3001,http://localhost

# ---------- First admin (created by npm run seed, password change forced at first login) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_now
ADMIN_FULL_NAME=Administrator
ORGANIZATION_NAME=CaseLab

# ---------- Claude (Anthropic API) ----------
# Without the key tasks use the template text and attempts wait in the queue
ANTHROPIC_API_KEY=
# Haiku writes short texts for the student, Sonnet grades and drafts for the lawyer (backend/src/modules/ai/llm-tasks.ts)
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_SMART=claude-sonnet-5-5
# A model for single tasks, e.g. evaluate=claude-opus-5-5,clientReply=claude-haiku-5-5
LLM_TASK_MODELS=
# Pacing of direct calls; set below the rate limits of your API tier
LLM_RPM=50
LLM_CONCURRENCY=4
# Prompt cache lifetime: 5m (writes x1.25) or 1h (writes x2, pays off when calls are 5-60 minutes apart)
LLM_CACHE_TTL=5m
# Background work through Message Batches at half the price: admin drafts, weekly summaries, the case pool
LLM_BATCH=on
LLM_BATCH_POLL_MS=60000
# Prepared cases per template and language for tomorrow (by the last 7 days of demand), 0 = off
LLM_POOL_SIZE=10